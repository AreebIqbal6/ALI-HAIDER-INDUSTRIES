# ==============================================================================
# WeaveSync SCADA - Industrial Edge Gateway Environment Configuration (.env)
# Client: Ali Haider Industries (SITE Industrial Area, Karachi)
# ==============================================================================

# Gateway Operational Mode:
#   SIM: All 36 looms driven by Poisson simulator
#   HYBRID: Loom 1 (PIC-427708) live from WT32-ETH01 hardware, Looms 2-36 simulated
#   LIVE: Only live physical hardware nodes forwarded
GATEWAY_MODE=HYBRID

# Target Machine ID for the localized PoE-Lite pilot node
PILOT_LOOM_ID=PIC-427708

# Local Ingestion Port for direct HTTP POST from WT32-ETH01
EDGE_GATEWAY_HTTP_PORT=4841

# MQTT Broker Connection String inside Docker network
MQTT_BROKER_URL=mqtt://mqtt-broker:1883

# SQLite Write-Ahead Logging (WAL) Outbox Database Path inside container
SQLITE_DB_PATH=/app/data/sqlite/outbox.db

# Cloud Database Synchronization (Supabase)
# Leave blank during offline local bench-testing; fill for live plant sync
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJh...
