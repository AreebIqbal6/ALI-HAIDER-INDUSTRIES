# WEAVESYNC SCADA (Ali Haider Industries) - Environment Configuration
# Copy to .env.local (never commit real values). On Vercel set these in Project Settings -> Environment Variables.

# --- Supabase (cloud mode) ---------------------------------------------------
NEXT_PUBLIC_ENABLE_SUPABASE=true
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY. Required for device ingest and all server-side writes. Never expose to the browser
# (no NEXT_PUBLIC_ prefix), never commit.
SUPABASE_SERVICE_ROLE_KEY=

# --- Ingest / admin ----------------------------------------------------------
# Device loggers authenticate with per-device bearer tokens (see scripts/provision-device.mjs).
# Optional: enables the legacy pre-contract x-weavesync-key path (LAN pilot only). Leave empty to disable.
LEGACY_INGEST_KEY=
# Required for DELETE /api/ingest/v1/batch (header x-admin-key). Leave empty to disable DELETE.
ADMIN_API_KEY=
# Optional: when set, requires x-operator-key or Supabase user JWT on /api/operator/* routes.
OPERATOR_API_KEY=
# 'true' seeds a clearly labelled demo loom DEMO-0001 in the local store. Keep unset/false in production.
DEMO_MODE=false

# --- Local LAN pilot (offline) -----------------------------------------------
OFFLINE_MODE=false

# --- Factory Edge Gateway Settings -------------------------------------------
GATEWAY_MODE=HYBRID # Options: SIM | HYBRID | LIVE
EDGE_GATEWAY_PORT=4840
EDGE_GATEWAY_HTTP_PORT=4841
PILOT_LOOM_ID=PIC-427708
MODBUS_SERIAL_PORT=/dev/ttyUSB0
MODBUS_BAUD_RATE=9600
HUAWEI_SOLAR_IP=192.168.1.50
HUAWEI_SOLAR_PORT=502
