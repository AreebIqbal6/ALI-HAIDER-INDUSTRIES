# WEAVESYNC SCADA (Ali Haider Industries) - Environment Configuration
# Copy this file to .env.local for local frontend development or on-site pilot deployment

# Local Factory Pilot / Offline Industrial Mode
NEXT_PUBLIC_ENABLE_SUPABASE=false
OFFLINE_MODE=true
INGEST_API_KEY=weavesync-industrial-secret-2026

# Supabase Project Credentials (Optional: Only if cloud sync is enabled)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-public-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# Factory Edge Gateway Settings
GATEWAY_MODE=HYBRID # Options: SIM | HYBRID | LIVE
EDGE_GATEWAY_PORT=4840
EDGE_GATEWAY_HTTP_PORT=4841
PILOT_LOOM_ID=PIC-427708
MODBUS_SERIAL_PORT=/dev/ttyUSB0
MODBUS_BAUD_RATE=9600
HUAWEI_SOLAR_IP=192.168.1.50
HUAWEI_SOLAR_PORT=502
